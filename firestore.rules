rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function active() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function admin() {
      return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function member() {
      return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['viewer','operator','admin'];
    }
    match /users/{uid} { allow read: if admin() || (active() && request.auth.uid == uid); allow write: if false; }
    match /{collection}/{id} {
      allow read: if member() && collection in ['buildings','meters','readings','bills','alerts','maintenanceTickets','actionVerifications','sustainabilitySnapshots','settings'];
      // All mutation goes through the validated, role-checked FastAPI service.
      // Admin SDK bypasses rules: backend authorization is mandatory.
      allow write: if false;
    }
  }
}
