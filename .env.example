# Backend: secure by default. Set APP_MODE=local only on loopback for local evaluation.
APP_MODE=production
FIREBASE_PROJECT_ID=your-project-id
# Prefer workload identity/ADC; an external service-account path may be used locally.
GOOGLE_APPLICATION_CREDENTIALS=/secure/external/path/service-account.json
CORS_ORIGINS=https://your-frontend.vercel.app
# Optional local mode only:
# LOCAL_DB_PATH=data/local.sqlite
